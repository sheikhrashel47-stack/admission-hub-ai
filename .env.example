# 🔴 EXAMPLE ONly — আসল key এখানে লিখো না, .env.local-এ লিখবে (gitignore করা)
# এই ফাইলটা repo-তে থাকলেও key-এর কোনো দরকার নেই — শুধু নামগুলো দেখার জন্য।
# সম্পূর্ণ তালিকা + ভূমিকা: docs/KEYS.md

# ═══ AI Models (যেকোনো একটা থাকলেই চলে) ═══
GROQ_API_KEY=            # console.groq.com — primary (দ্রুত, ফ্রি)
GEMINI_API_KEY=          # aistudio.google.com/apikey — fallback (১M context) + vision
CEREBRAS_API_KEY=        # cloud.cerebras.ai — fallback (ultra-fast)
MISTRAL_API_KEY=         # console.mistral.ai — fallback
OPENROUTER_API_KEY=      # openrouter.ai/keys — fallback (১০০+ মডেল)

# ═══ Web Research ═══
TAVILY_API_KEY=          # app.tavily.com — 1000 search/মাস ফ্রি

# ═══ Phase 3+ tools ═══
BROWSER_USE_API_KEY_1=   # cloud.browser-use.com — browser agent (ভাড়া ক্রেডিট)
BROWSER_USE_API_KEY_2=   # rotation #2
BROWSER_USE_API_KEY_3=   # rotation #3
WEBCONTAINERS_API_KEY=   # webcontainers.io — browser-side code sandbox (clientId)
OLLAMA_API_KEY=          # ollama.com cloud — ওপেন-মডেল fallback

# ═══ অ্যাকাউন্ট/অটোমেশন ═══
CF_TOKEN=                # Cloudflare API token (Pages deploy)
CF_ACCOUNT_ID=           # Cloudflare account id (abb783e4…)
R2_ACCESS_KEY_ID=        # Cloudflare R2 (S3) — Phase 5/7 storage
R2_SECRET_ACCESS_KEY=    # Cloudflare R2 (S3)
R2_ENDPOINT=             # https://<account_id>.r2.cloudflarestorage.com

# ═══ Google Drive storage (Desktop app OAuth — docs/GOOGLE-DRIVE-SETUP.md) ═══
# ⚠️ "Web application" নয় — **Desktop app** ক্লায়েন্ট বানাতে হবে, নইলে 403 access_denied
# টোকেন নিতে: node scripts/gdrive-auth.mjs link <CLIENT_ID>
GOOGLE_DRIVE_CLIENT_ID_1=      # xxxx.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET_1=  # GOCSPX-xxxx
GOOGLE_DRIVE_REFRESH_TOKEN_1=  # 1//xxxx  (scope: drive.file)
GOOGLE_DRIVE_CLIENT_ID_2=      # ২য় অ্যাকাউন্ট — ঐচ্ছিক (কোটা ভরলে অটো fallback)
GOOGLE_DRIVE_CLIENT_SECRET_2=
GOOGLE_DRIVE_REFRESH_TOKEN_2=
GITHUB_PAT=              # GitHub personal access token (repo/deploy)
NPM_TOKEN=               # npmjs publish token — Phase 8
SUPABASE_PAT=            # supabase.com management token — Phase 5-6 (DB/auth)

# ═══ Storage routing (ঐচ্ছিক) ═══
STORAGE_PROVIDER=        # নির্দিষ্ট provider-এ বাধ্য করতে: gdrive | local (খালি = auto-fallback চেইন)
STORAGE_LOCAL_DIR=       # ডিফল্ট ./data/files — ডিস্ক fallback
STORAGE_DISABLE_LOCAL=   # 1 দিলে ডিস্ক fallback বন্ধ
