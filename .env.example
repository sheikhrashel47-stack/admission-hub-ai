# 🔴 EXAMPLE ONly — আসল key এখানে লিখো না, .env.local-এ লিখবে (gitignore করা)
# এই ফাইলটা repo-তে থাকলেও key-এর কোনো দরকার নেই — শুধু নামগুলো দেখার জন্য।

# AI Models (যেকোনো একটা থাকলেই চলে)
GROQ_API_KEY=            # console.groq.com — primary (দ্রুত, ফ্রি)
GEMINI_API_KEY=          # aistudio.google.com/apikey — fallback (১M context)
CEREBRAS_API_KEY=        # cloud.cerebras.ai — fallback
MISTRAL_API_KEY=         # console.mistral.ai — fallback
OPENROUTER_API_KEY=      # openrouter.ai/keys — fallback

# Web Research
TAVILY_API_KEY=          # app.tavily.com — 1000 search/মাস ফ্রি

# ভবিষ্যতে (Phase 5+)
# GH_PAT=                # GitHub read-only token (আপাতত দরকার নেই)
# E2B_API_KEY=           # sandbox (Phase 6)
